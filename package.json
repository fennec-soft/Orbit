{
  "name": "pc-meeting-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.fennecsoft.meetingapp",
    "productName": "Meeting App",
    "win": {
      "target": "nsis",
      "icon": "MEETING-APP.ico"
    },
    "files": [
      "**/*",
      "server.js",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "nodemailer": "^9.0.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
